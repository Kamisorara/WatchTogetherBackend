<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.wt.dao.mapper.WtMoviesMapper">
    <select id="getMovieList" resultType="com.wt.entity.wt.WtMovies">
        SELECT *
        FROM wt_movies
        ORDER BY create_time DESC
    </select>

    <select id="getMovieListByUploader" resultType="com.wt.entity.wt.WtMovies">
        SELECT *
        FROM wt_movies
        WHERE uploader_id = #{uploaderId}
        ORDER BY create_time DESC
    </select>

    <select id="selectMovieById" resultType="com.wt.entity.wt.WtMovies">
        SELECT *
        FROM wt_movies
        WHERE id = #{id}
    </select>
</mapper>